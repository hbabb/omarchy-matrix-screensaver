#!/bin/bash

# omarchy:summary=Matrix-only fork of the Omarchy screensaver: a continuous
# digital-rain waterfall in the original movie green, forked from
# /usr/bin/omarchy-screensaver (which cycles random TTE effects). This file
# lives in ~/.local/bin, which ~/.config/hypr/hyprland.lua puts first on
# PATH (ahead of Omarchy's own bin dir), so it takes priority over the stock
# script without ever touching /usr/share/omarchy.

screensaver_in_focus() {
  hyprctl activewindow -j | jq -e '.class == "org.omarchy.screensaver"' >/dev/null 2>&1
}

exit_screensaver() {
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null || hyprctl keyword cursor:invisible false &>/dev/null || true
  pkill -x ttfx 2>/dev/null
  pkill -f '[o]rg.omarchy.screensaver' 2>/dev/null
  exit 0
}

# Exit the screensaver on signals and input from keyboard and mouse
trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT

printf '\033]11;rgb:00/00/00\007'  # Set background color to black

hyprctl eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null || hyprctl keyword cursor:invisible true &>/dev/null

tty=$(tty 2>/dev/null)

# Terminals allocate the pty at the default 80x24 and only resize it once the
# compositor has told the window how big it is. ttfx measures the terminal once,
# at startup, so starting it before the resize lands sizes an 80x24 canvas and
# paints it into the corner of a fullscreen window.
wait_for_terminal_resize() {
  local deadline=$((SECONDS + 2))
  while ((SECONDS < deadline)) && [[ $(stty size 2>/dev/null) == "24 80" ]]; do
    sleep 0.02
  done
}

wait_for_terminal_resize

# ttfx's matrix effect requires an input file and eventually resolves the
# rain into it. We never want that resolve to be visible -- this is meant to
# be the movie's endless code waterfall, not a logo screensaver -- so the
# input is a single harmless glyph and --rain-time is set far past any
# realistic idle session (see the loop below).
input_file="$HOME/.config/omarchy/branding/screensaver-matrix.txt"
[[ -s $input_file ]] || printf '.' > "$input_file"

while true; do
  ttfx -i "$input_file" \
    --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c \
    --no-eol --no-restore-cursor \
    matrix \
    --rain-time 86400 \
    --highlight-color 00FF41 \
    --rain-color-gradient 00FF41 008F11 003B00 \
    --final-gradient-stops 00FF41 003B00 \
    --rain-fall-delay-range 5-30 \
    --rain-column-delay-range 1-2 &

  while pgrep -t "${tty#/dev/}" -x ttfx >/dev/null; do
    if read -n1 -t 1 || ! screensaver_in_focus; then
      exit_screensaver
    fi
  done
done

[Unit]
Description=Omarchy idle extender (screen blank + AC/battery-aware sleep)
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=%h/.local/bin/omarchy-idle-extender
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
